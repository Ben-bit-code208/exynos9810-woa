<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="S9Woa.Installer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Galaxy S9+ Windows Installer">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Galaxy S9+ Windows Installer" Subtitle="Preview">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step rail -->
            <Grid Padding="14,20,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl x:Name="StepList" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Style="{StaticResource RailButtonStyle}" Tag="{Binding Index}" Click="OnStepClick"
                                        IsHitTestVisible="{Binding Reachable}" AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28">
                                            <Ellipse Fill="{Binding CircleFill}" Stroke="{Binding CircleStroke}" StrokeThickness="1.5" />
                                            <TextBlock Text="{Binding Number}" Visibility="{Binding NumberVisibility}" Foreground="{Binding CircleForeground}"
                                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE73E;" Visibility="{Binding CheckVisibility}" Foreground="{Binding CircleForeground}"
                                                      FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleForeground}"
                                                   FontWeight="{Binding TitleWeight}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Rectangle Width="1.5" Height="14" Margin="23,0,0,0" HorizontalAlignment="Left"
                                           Fill="{Binding ConnectorBrush}" Visibility="{Binding ConnectorVisibility}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button x:Name="ToolsLink" Style="{StaticResource RailButtonStyle}" Click="OnTools">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="28" />
                            <TextBlock Text="Device tools" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutLink" Style="{StaticResource RailButtonStyle}" Click="OnAbout">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="28" />
                            <TextBlock Text="About" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content surface, layered over Mica like Windows Settings -->
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
                <Grid Grid.Row="1" Padding="56,14,32,14" ColumnSpacing="8"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepCaption" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}" />
                    <Button x:Name="BackButton" Grid.Column="1" Content="Back" MinWidth="120" Click="OnBack" />
                    <Button x:Name="NextButton" Grid.Column="2" Content="Continue" MinWidth="140" Click="OnNext"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
