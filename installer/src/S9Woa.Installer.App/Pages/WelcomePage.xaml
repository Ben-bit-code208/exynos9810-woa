<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
            <Border CornerRadius="12" Padding="32,36">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1B3A8C" Offset="0" />
                        <GradientStop Color="#FF3A7BD5" Offset="0.55" />
                        <GradientStop Color="#FF00B4DB" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows on your Galaxy S9+" Foreground="White" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Foreground="#E6FFFFFF" TextWrapping="Wrap" Style="{StaticResource BodyLargeTextBlockStyle}"
                               Text="This installer takes an Exynos Galaxy S9+ (SM-G965F) from stock Android to a running Windows 11 on ARM, with open-source UEFI firmware and drivers." />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="This erases your phone"
                     Message="Unlocking the bootloader wipes Android, and Windows replaces the Android system and data partitions. Back up everything you want to keep first." />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Experimental software"
                     Message="Only one phone model and firmware have been validated. Cellular, camera, audio and GPU acceleration do not work yet. Unlocking permanently trips Knox (Samsung Pay, Secure Folder and some warranty services stop working)." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="What you need" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Text="• A Samsung Galaxy S9+ SM-G965F (Exynos), charged above 60%." />
                    <TextBlock TextWrapping="Wrap" Text="• A good USB-C data cable, connected directly to this PC." />
                    <TextBlock TextWrapping="Wrap" Text="• About 80 GB free on this PC and roughly an hour." />
                    <TextBlock TextWrapping="Wrap" Text="• A Windows 11 ARM64 image (ISO or ESD), or an internet connection to download one." />
                    <TextBlock TextWrapping="Wrap" Text="• A USB-C keyboard/mouse adapter is recommended for the first Windows setup." />
                </StackPanel>
            </Border>

            <CheckBox x:Name="AcceptBox" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged"
                      Content="I understand this will erase my phone and that the software is experimental." />
            <Button x:Name="ContinueButton" Content="Get started" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False" Click="OnContinue" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</Page>
