<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Check this PC" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="The installer builds the Windows image here, so it needs administrator rights, disk space and the Android and Samsung USB tools." />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkDirBox" Header="Working folder (image and phone backups)" />
                        <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="OnBrowse" />
                    </Grid>
                    <ItemsControl x:Name="Results" ItemTemplate="{StaticResource CheckItemTemplate}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check again" Click="OnRecheck" />
                <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButtonStyle}" Click="OnContinue" MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
