<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}">
            <StackPanel>
                <TextBlock Text="Check this PC" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,8"
                           Text="The Windows image is built here, so the installer needs administrator rights, room for the image and your phone's backup, and the phone tools." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Working folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="WorkDirText" Style="{StaticResource CaptionSecondaryStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Change…" Click="OnBrowse" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20,6">
                <ItemsControl x:Name="Results" ItemTemplate="{StaticResource CheckItemTemplate}" />
            </Border>

            <HyperlinkButton Content="Check again" Click="OnRecheck" Padding="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
