<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.PhonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Connect your phone" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="On the phone: Settings › About phone › Software information, tap Build number seven times. Then in Developer options turn on USB debugging and OEM unlocking, connect the cable and tap Allow." />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Looking for a phone…" Message="Connect the phone with USB debugging enabled." />

            <Border x:Name="DeviceCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8EA;" FontSize="56" VerticalAlignment="Top" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="DeviceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DeviceDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl x:Name="Results" Margin="0,8,0,0" ItemTemplate="{StaticResource CheckItemTemplate}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Click="OnRebootRecovery" ToolTipService.ToolTip="adb reboot recovery">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="14" /><TextBlock Text="Reboot to TWRP" /></StackPanel>
                            </Button>
                            <Button Click="OnRebootDownload" ToolTipService.ToolTip="adb reboot download">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Download mode" /></StackPanel>
                            </Button>
                            <Button Click="OnRebootSystem" ToolTipService.ToolTip="adb reboot">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Restart" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Header="How do I unlock the bootloader?" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap" Text="1. Turn on OEM unlocking in Developer options. If it is missing, connect to Wi-Fi, set the date back or wait up to 7 days (Samsung's RMM/KG lock)." />
                    <TextBlock TextWrapping="Wrap" Text="2. Power off. Hold Volume Down + Bixby and plug in the USB cable to enter Download mode." />
                    <TextBlock TextWrapping="Wrap" Text="3. Long-press Volume Up to unlock, then confirm with Volume Up. The phone erases itself and restarts." />
                    <TextBlock TextWrapping="Wrap" Text="4. Complete Android setup offline, enable USB debugging again and come back here." />
                </StackPanel>
            </Expander>

            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False" Click="OnContinue" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</Page>
