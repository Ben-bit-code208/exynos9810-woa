<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.PhonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}">
            <StackPanel>
                <TextBlock Text="Connect your phone" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Turn on USB debugging, plug the phone into this PC and tap Allow when it asks. The installer checks it's a supported model and firmware." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon x:Name="DeviceIcon" Glyph="&#xE8EA;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressRing x:Name="SearchRing" IsActive="True" Width="52" Height="52" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceTitle" Text="Looking for your phone…" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DeviceDetail" Text="Connect it with USB debugging turned on." Style="{StaticResource CaptionSecondaryStyle}" FontSize="13" />
                    </StackPanel>
                    <DropDownButton x:Name="RebootMenu" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed"
                                    Content="Restart phone into…">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="TWRP recovery" Click="OnRebootRecovery">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Download mode" Click="OnRebootDownload">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Normal restart" Click="OnRebootSystem">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </Border>

            <InfoBar x:Name="StatusBar" IsClosable="False" />

            <Border x:Name="ChecksCard" Style="{StaticResource CardStyle}" Padding="28,8" Visibility="Collapsed">
                <ItemsControl x:Name="Results" ItemTemplate="{StaticResource CheckItemTemplate}" />
            </Border>

            <TextBlock Text="Help" Style="{StaticResource SectionHeaderStyle}" />
            <Expander Header="Turn on USB debugging" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap" Text="1. Settings › About phone › Software information: tap Build number seven times." />
                    <TextBlock TextWrapping="Wrap" Text="2. Settings › Developer options: turn on USB debugging and OEM unlocking." />
                    <TextBlock TextWrapping="Wrap" Text="3. Connect the cable and tap Allow on the “Allow USB debugging?” prompt." />
                </StackPanel>
            </Expander>
            <Expander Header="Unlock the bootloader" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap" Text="1. Turn on OEM unlocking in Developer options. If it's missing, connect to Wi-Fi and check for software updates; Samsung can hide it for up to 7 days." />
                    <TextBlock TextWrapping="Wrap" Text="2. Power off. Hold Volume Down + Bixby and plug in the USB cable to enter Download mode." />
                    <TextBlock TextWrapping="Wrap" Text="3. Long-press Volume Up to unlock, then confirm with Volume Up. The phone erases itself and restarts." />
                    <TextBlock TextWrapping="Wrap" Text="4. Finish Android setup offline, turn USB debugging back on and come back here." />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
