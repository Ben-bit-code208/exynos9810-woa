<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,24,40,24" RowSpacing="16" ColumnSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Install" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="ReviewText" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <ListView x:Name="Timeline" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="18" />
                                <ProgressRing IsActive="{Binding RingActive}" Width="20" Height="20" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Visibility="{Binding BadgeVisibility}" CornerRadius="4" Padding="6,1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Activity" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
                <ScrollViewer x:Name="LogScroll">
                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
            <InfoBar x:Name="ResultBar" IsClosable="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart" MinWidth="160">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Name="StartText" Text="Start" /></StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" />
                <Button Content="Open logs folder" Click="OnOpenLogs" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
