<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}">
            <StackPanel>
                <TextBlock x:Name="HeadlineText" Text="Ready to install" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="LeadText" Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,8"
                           Text="Review your choices, then press Install. Slow work on this PC happens first; the phone is only written after it's been backed up." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Phone" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="ReviewPhone" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Windows media" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="ReviewMedia" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="Image" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="ReviewProfile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Account" Style="{StaticResource CaptionSecondaryStyle}" />
                        <TextBlock x:Name="ReviewAccount" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="16" Padding="0,10,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Verify every write" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                                       Text="Reads each block back on the phone and compares checksums. Adds a few minutes; turn off for the fastest install." />
                        </StackPanel>
                        <ToggleSwitch x:Name="VerifyToggle" Grid.Column="1" Toggled="OnVerifyToggled" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="Verify every write" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="RunningPanel" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Cancel" Click="OnCancel" />
            </Grid>

            <InfoBar x:Name="ResultBar" IsClosable="True" />

            <TextBlock Text="Steps" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}" Padding="8,6">
                <ItemsControl x:Name="Timeline">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                    <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="16" />
                                    <ProgressRing IsActive="{Binding RingActive}" Width="16" Height="16" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Visibility="{Binding BadgeVisibility}" CornerRadius="4" Padding="6,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Run experimental steps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                                   Text="Automated but not yet validated end to end. Turn on only if you're testing on your own Galaxy S9+ and have its backup." />
                    </StackPanel>
                    <ToggleSwitch x:Name="ExperimentalToggle" Grid.Column="1" Toggled="OnExperimentalToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>

            <Expander Header="Activity" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <ScrollViewer x:Name="LogScroll" MaxHeight="240">
                        <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <HyperlinkButton Content="Open logs folder" Click="OnOpenLogs" Padding="0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
