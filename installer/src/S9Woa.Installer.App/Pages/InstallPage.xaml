<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One screen: progress and choices on the left, every step on the right, the log folded away. -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="56,36,56,24">
        <Grid RowSpacing="20" MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock x:Name="HeadlineText" Text="Ready to install" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LeadText" Style="{StaticResource PageSubtitleStyle}" Margin="0"
                           Text="Slow work on this PC happens first; the phone is only written after it's been backed up." />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="16">
                    <!-- What is happening now -->
                    <Border Style="{StaticResource CardStyle}" Padding="24,20">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="NowCaption" Text="Next step" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="NowTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="OnCancel"
                                        VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="NowDetail" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" MinHeight="18" />
                            <ProgressBar x:Name="StepProgress" Maximum="1" Visibility="Collapsed" />
                            <Grid ColumnSpacing="12" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Overall" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center" />
                                <ProgressBar x:Name="OverallProgress" Grid.Column="1" Maximum="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="OverallText" Grid.Column="2" Style="{StaticResource CaptionSecondaryStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <InfoBar x:Name="ResultBar" IsClosable="True" />

                    <!-- Choices -->
                    <Border Style="{StaticResource CardStyle}" Padding="24,18">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="24" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Phone" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewPhone" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Windows media" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewMedia" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="1">
                                    <TextBlock Text="Image" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewProfile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Account" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewAccount" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Verify every write" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                                               Text="Reads each block back on the phone. A few minutes slower." />
                                </StackPanel>
                                <ToggleSwitch x:Name="VerifyToggle" Grid.Column="1" Toggled="OnVerifyToggled" OnContent="" OffContent=""
                                              MinWidth="0" AutomationProperties.Name="Verify every write" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Run experimental steps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                                               Text="Automated, not yet validated end to end. Only with your phone's backup." />
                                </StackPanel>
                                <ToggleSwitch x:Name="ExperimentalToggle" Grid.Column="1" Toggled="OnExperimentalToggled" OnContent=""
                                              OffContent="" MinWidth="0" AutomationProperties.Name="Run experimental steps" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Every step, compact; hover for what it does -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12,14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Steps" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0,0,6" />
                        <ItemsControl x:Name="Timeline" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,7" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{Binding Tip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" />
                                            <ProgressRing IsActive="{Binding RingActive}" Width="14" Height="14" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="{Binding TitleWeight}"
                                                   Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Expander Grid.Row="2" Header="Activity" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <ScrollViewer x:Name="LogScroll" MaxHeight="200">
                        <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <HyperlinkButton Content="Open logs folder" Click="OnOpenLogs" Padding="0" />
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
