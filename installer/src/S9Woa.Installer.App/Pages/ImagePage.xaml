<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Style="{StaticResource PageColumnStyle}">
            <StackPanel>
                <TextBlock Text="Choose your Windows" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Pick the Windows 11 ARM64 media, how lean the installed system should be, and the account you'll sign in with." />
            </StackPanel>

            <TextBlock Text="Windows media" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MediaBox" PlaceholderText="Windows 11 ARM64 .iso, .wim or .esd" TextChanged="OnMediaTextChanged" />
                        <Button Grid.Column="1" Content="Browse…" Click="OnBrowse" />
                    </Grid>
                    <StackPanel x:Name="ExtractPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="ExtractText" Style="{StaticResource CaptionSecondaryStyle}" />
                        <ProgressBar x:Name="ExtractProgress" Maximum="1" />
                    </StackPanel>
                    <TextBlock x:Name="MediaHint" Style="{StaticResource CaptionSecondaryStyle}"
                               Text="Any Windows 11 ARM64 image can be installed; builds without a matching UEFI may stop at the Samsung logo." />
                </StackPanel>
            </Border>

            <TextBlock Text="Image size" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StockCard" Style="{StaticResource CardStyle}" Padding="18,16">
                    <RadioButton x:Name="StockOption" GroupName="Profile" Tag="None" Checked="OnProfileChecked" VerticalAlignment="Top" VerticalContentAlignment="Top">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Stock" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Windows as shipped, plus drivers." Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </RadioButton>
                </Border>
                <Border x:Name="LiteCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18,16">
                    <RadioButton x:Name="LiteOption" GroupName="Profile" Tag="Lite" Checked="OnProfileChecked" VerticalAlignment="Top" VerticalContentAlignment="Top">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Lite" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Recommended. Leaner, still updatable." Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </RadioButton>
                </Border>
                <Border x:Name="CoreCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,16">
                    <RadioButton x:Name="CoreOption" GroupName="Profile" Tag="Core" Checked="OnProfileChecked" VerticalAlignment="Top" VerticalContentAlignment="Top">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Core" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Smallest and fastest. Not updatable." Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </RadioButton>
                </Border>
            </Grid>
            <TextBlock x:Name="ProfileSummary" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
            <InfoBar x:Name="CoreWarning" IsClosable="False" Severity="Warning" Title="Core removes safety nets"
                     Message="Based on tiny11 Core. No Windows Update, Defender, Edge, recovery environment or way to add features and languages later. Choose it only for a throwaway or offline device." />

            <TextBlock Text="Your account" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AccountName" Header="User name" Text="S9" TextChanged="OnAccountChanged" />
                        <PasswordBox x:Name="AccountPassword" Grid.Column="1" Header="Password (optional)" PasswordChanged="OnAccountChanged" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                               Text="Windows setup finishes on its own and signs you in to this local administrator account. You can add a Microsoft account later." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
