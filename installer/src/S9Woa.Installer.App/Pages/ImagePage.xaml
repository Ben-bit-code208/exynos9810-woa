<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="S9Woa.Installer.App.Pages.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageRootStyle}">
        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Choose Windows" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Pick the Windows 11 ARM64 media to install and how much of it to keep." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Windows media" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="SourceChoice" SelectionChanged="OnSourceChanged" SelectedIndex="0">
                        <RadioButton Content="Use an ISO, ESD or WIM file on this PC" />
                        <RadioButton Content="Download from Microsoft (coming soon)" IsEnabled="False" />
                    </RadioButtons>
                    <Grid ColumnSpacing="8" x:Name="FileRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MediaBox" PlaceholderText="Windows 11 ARM64 .iso, .esd or .wim" TextChanged="OnMediaTextChanged" />
                        <Button Grid.Column="1" Content="Browse" Click="OnBrowse" />
                    </Grid>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Validated build"
                             Message="The drivers are validated on Windows 11 build 22621/22631 (23H2) ARM64. Newer builds such as 24H2 (26100) have not been tested on this phone." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Lightweight image" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="The phone has 6 GB of RAM and a slow CPU for Windows. Removing inbox apps and background services makes it noticeably faster." />
                    <RadioButtons x:Name="ProfileChoice" SelectionChanged="OnProfileChanged">
                        <RadioButton Content="Stock" Tag="None" />
                        <RadioButton Content="Lite (recommended)" Tag="Lite" />
                        <RadioButton Content="Core (smallest, not updatable)" Tag="Core" />
                    </RadioButtons>
                    <TextBlock x:Name="ProfileSummary" TextWrapping="Wrap" />
                    <InfoBar x:Name="CoreWarning" IsClosable="False" Severity="Warning" Title="Core removes safety nets"
                             Message="No Windows Update, no Defender antivirus, no recovery environment and no way to add features or languages later. Only choose Core for a throwaway or offline device." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Your Windows account" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="The installer finishes setup automatically and signs you in to a local administrator account with these details. You can add a Microsoft account later in Windows." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AccountName" Header="User name" Text="S9" TextChanged="OnAccountChanged" />
                        <PasswordBox x:Name="AccountPassword" Grid.Column="1" Header="Password (optional)" PasswordChanged="OnAccountChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False" Click="OnContinue" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</Page>
