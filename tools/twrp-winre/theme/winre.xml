			<action>
				<condition var1="winre_push" op="!=" var2="0"/>
				<actions>
					<action function="page">winre_push</action>
				</actions>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">winre_troubleshoot</action>
			</action>
			<action>
				<touch key="power"/>
				<action function="togglebacklight"/>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="winre_advanced2">
			<background color="%winre_bg%"/>

			<button>
				<placement x="0" y="%winre_back_hit_y%" w="240" h="180"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<action function="page">winre_advanced</action>
			</button>
			<image>
				<image resource="winre_ic_back"/>
				<placement x="%winre_back_x%" y="%winre_back_y%" placement="4"/>
			</image>

			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%winre_margin%" y="%winre_hdr_y%"/>
				<text>More options</text>
			</text>

			<!-- Erase PRAM -->
			<button>
				<placement x="%winre_margin%" y="%winre_r1_y%" w="%winre_tile_w%" h="%winre_tile_h%"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<actions>
					<action function="set">tw_operation_state=0</action>
					<action function="set">tw_back=winre_advanced2</action>
					<action function="set">tw_has_action2=0</action>
					<action function="set">tw_terminal_location=/</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/sbin/winre-gui.sh /sbin/winre-pram.sh erase</action>
					<action function="set">winre_busy_title=Erasing the PRAM log</action>
					<action function="set">winre_done_title=PRAM log erased</action>
					<action function="set">winre_done_sub=A copy was saved to /sdcard/WinRE first</action>
					<action function="set">winre_confirm_h=Erase PRAM</action>
					<action function="set">winre_confirm_l1=Everything the last boot recorded in the persistent</action>
					<action function="set">winre_confirm_l2=ring is cleared. A copy is saved to /sdcard first, so a</action>
					<action function="set">winre_confirm_l3=capture is never lost by pressing this button.</action>
					<action function="set">winre_confirm_btn=Erase</action>
					<action function="page">winre_confirm</action>
				</actions>
			</button>
			<image>
				<image resource="winre_ic_erase"/>
				<placement x="%winre_icon_x%" y="%winre_r1_icon_y%" placement="4"/>
			</image>
			<text color="%winre_text%">
				<font resource="winre_title"/>
				<placement x="%winre_text_x%" y="%winre_r1_title_y%"/>
				<text>Erase PRAM</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_text_x%" y="%winre_r1_desc_y%"/>
				<text>Clear the ring so the next boot starts from empty</text>
			</text>

			<!-- Full TWRP interface -->
			<button>
				<placement x="%winre_margin%" y="%winre_r2_y%" w="%winre_tile_w%" h="%winre_tile_h%"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<actions>
					<action function="set">tw_clear_destination=twrp_main2</action>
					<action function="page">clear_vars</action>
				</actions>
			</button>
			<image>
				<image resource="winre_ic_disk"/>
				<placement x="%winre_icon_x%" y="%winre_r2_icon_y%" placement="4"/>
			</image>
			<text color="%winre_text%">
				<font resource="winre_title"/>
				<placement x="%winre_text_x%" y="%winre_r2_title_y%"/>
				<text>Full TWRP interface</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_text_x%" y="%winre_r2_desc_y%"/>
				<text>Install, backup, restore, mount, partition tools</text>
			</text>

			<!-- Restart to Download mode -->
			<button>
				<placement x="%winre_margin%" y="%winre_r3_y%" w="%winre_tile_w%" h="%winre_tile_h%"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<action function="page">winre_go_download</action>
			</button>
			<image>
				<image resource="winre_ic_download"/>
				<placement x="%winre_icon_x%" y="%winre_r3_icon_y%" placement="4"/>
			</image>
			<text color="%winre_text%">
				<font resource="winre_title"/>
				<placement x="%winre_text_x%" y="%winre_r3_title_y%"/>
				<text>Restart to Download mode</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_text_x%" y="%winre_r3_desc_y%"/>
				<text>Odin / Heimdall recovery path if a flash goes wrong</text>
			</text>

			<action>
				<condition var1="winre_push" op="!=" var2="0"/>
				<actions>
					<action function="page">winre_push</action>
				</actions>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">winre_advanced</action>
			</action>
			<action>
				<touch key="power"/>
				<action function="togglebacklight"/>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<!-- ============================ confirm =========================== -->
		<!-- A generic confirmation. The tile that leads here has already set the
		     winre_run action variables AND the winre_confirm_* text, so "Run"
		     only has to navigate; nothing about the pending action lives on this
		     page. -->
		<page name="winre_confirm">
			<background color="%winre_bg%"/>

			<button>
				<placement x="0" y="%winre_back_hit_y%" w="240" h="180"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<action function="page">%tw_back%</action>
			</button>
			<image>
				<image resource="winre_ic_back"/>
				<placement x="%winre_back_x%" y="%winre_back_y%" placement="4"/>
			</image>

			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%winre_margin%" y="%winre_hdr_y%"/>
				<text>%winre_confirm_h%</text>
			</text>

			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_margin%" y="%winre_r1_y%"/>
				<text>%winre_confirm_l1%</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_margin%" y="%winre_p2_y%"/>
				<text>%winre_confirm_l2%</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_margin%" y="%winre_p3_y%"/>
				<text>%winre_confirm_l3%</text>
			</text>

			<button>
				<placement x="%winre_margin%" y="%winre_btn_row_y%" w="400" h="110"/>
				<fill color="%winre_btn%"/>
				<highlight color="%winre_btn_hi%"/>
				<font resource="winre_title" color="%winre_text%"/>
				<text>%winre_confirm_btn%</text>
				<actions>
					<action function="clear"/>
					<action function="page">winre_run</action>
				</actions>
			</button>

			<button>
				<placement x="%winre_btn2_x%" y="%winre_btn_row_y%" w="400" h="110"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<font resource="winre_title" color="%winre_text%"/>
				<text>Cancel</text>
				<action function="page">%tw_back%</action>
			</button>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">%tw_back%</action>
			</action>
			<action>
				<touch key="power"/>
				<action function="togglebacklight"/>
			</action>
		</page>

		<!-- ============================== run ============================= -->
		<!-- Runs %tw_action% and streams its stdout into the console, then hands
		     over to winre_output once TWRP reports the operation finished. Same
		     handshake the stock action_page uses. NEVER use openrecoveryscript
		     here: it reboots to Android whenever the script it runs succeeds. -->
		<page name="winre_run">
			<background color="%winre_bg%"/>

			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%winre_margin%" y="%winre_hdr_y%"/>
				<text>%winre_busy_title%</text>
			</text>

			<console>
				<placement x="%winre_margin%" y="%winre_console_y%" w="%winre_tile_w%" h="%winre_console_h%"/>
				<background color="%winre_console_bg%"/>
				<color foreground="%winre_text%" background="%winre_console_bg%" scroll="%winre_console_bg%"/>
				<font resource="winre_mono" color="%winre_text%"/>
				<fastscroll rectcolor="%winre_text_dim%" w="24" rectw="24" recth="108"/>
			</console>

			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<actions>
					<action function="page">winre_output</action>
				</actions>
			</action>

			<action>
				<condition var1="tw_has_action2" var2="0"/>
				<actions>
					<action function="%tw_action%">%tw_action_param%</action>
				</actions>
			</action>

			<action>
				<condition var1="tw_has_action2" var2="1"/>
				<actions>
					<action function="%tw_action%">%tw_action_param%</action>
					<action function="%tw_action2%">%tw_action2_param%</action>
				</actions>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">%tw_back%</action>
			</action>
			<action>
				<touch key="power"/>
				<action function="togglebacklight"/>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="winre_output">
			<background color="%winre_bg%"/>

			<button>
				<placement x="0" y="%winre_back_hit_y%" w="240" h="180"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<action function="page">%tw_back%</action>
			</button>
			<image>
				<image resource="winre_ic_back"/>
				<placement x="%winre_back_x%" y="%winre_back_y%" placement="4"/>
			</image>

			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%winre_margin%" y="%winre_hdr_y%"/>
				<text>%winre_done_title%</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%winre_margin%" y="%winre_sub_y%"/>
				<text>%winre_done_sub%</text>
			</text>

			<console>
				<placement x="%winre_margin%" y="%winre_console_y%" w="%winre_tile_w%" h="%winre_console_h%"/>
				<background color="%winre_console_bg%"/>
				<color foreground="%winre_text%" background="%winre_console_bg%" scroll="%winre_console_bg%"/>
				<font resource="winre_mono" color="%winre_text%"/>
				<fastscroll rectcolor="%winre_text_dim%" w="24" rectw="24" recth="108"/>
			</console>

			<button>
				<placement x="%winre_margin%" y="%winre_out_btn_y%" w="400" h="110"/>
				<fill color="%winre_btn%"/>
				<highlight color="%winre_btn_hi%"/>
				<font resource="winre_title" color="%winre_text%"/>
				<text>Back</text>
				<action function="page">%tw_back%</action>
			</button>

			<button>
				<placement x="%winre_btn2_x%" y="%winre_out_btn_y%" w="400" h="110"/>
				<fill color="%winre_clear%"/>
				<highlight color="%winre_hi%"/>
				<font resource="winre_title" color="%winre_text%"/>
				<text>Home</text>
				<action function="page">main</action>
			</button>

			<action>
				<condition var1="winre_push" op="!=" var2="0"/>
				<actions>
					<action function="page">winre_push</action>
				</actions>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">%tw_back%</action>
			</action>
			<action>
				<touch key="power"/>
				<action function="togglebacklight"/>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<!-- ======================== power transitions ==================== -->
		<page name="winre_go_system">
			<background color="%winre_bg%"/>
			<animation>
				<placement x="%winre_cogs_x%" y="%winre_cogs_wait_y%"/>
				<resource name="winre_cogs"/>
				<speed fps="24" render="1"/>
				<loop frame="1"/>
			</animation>
			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%center_x%" y="%winre_wait_y%" placement="5"/>
				<text>Please wait</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%center_x%" y="%winre_wait_sub_y%" placement="5"/>
				<text>Continuing to Windows</text>
			</text>
			<action>
				<action function="reboot">system</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="winre_go_recovery">
			<background color="%winre_bg%"/>
			<animation>
				<placement x="%winre_cogs_x%" y="%winre_cogs_wait_y%"/>
				<resource name="winre_cogs"/>
				<speed fps="24" render="1"/>
				<loop frame="1"/>
			</animation>
			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%center_x%" y="%winre_wait_y%" placement="5"/>
				<text>Please wait</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%center_x%" y="%winre_wait_sub_y%" placement="5"/>
				<text>Restarting into recovery</text>
			</text>
			<action>
				<action function="reboot">recovery</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="winre_go_poweroff">
			<background color="%winre_bg%"/>
			<animation>
				<placement x="%winre_cogs_x%" y="%winre_cogs_wait_y%"/>
				<resource name="winre_cogs"/>
				<speed fps="24" render="1"/>
				<loop frame="1"/>
			</animation>
			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%center_x%" y="%winre_wait_y%" placement="5"/>
				<text>Please wait</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%center_x%" y="%winre_wait_sub_y%" placement="5"/>
				<text>Turning off your PC</text>
			</text>
			<action>
				<action function="reboot">poweroff</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>

		<page name="winre_go_download">
			<background color="%winre_bg%"/>
			<animation>
				<placement x="%winre_cogs_x%" y="%winre_cogs_wait_y%"/>
				<resource name="winre_cogs"/>
				<speed fps="24" render="1"/>
				<loop frame="1"/>
			</animation>
			<text color="%winre_text%">
				<font resource="winre_h1"/>
				<placement x="%center_x%" y="%winre_wait_y%" placement="5"/>
				<text>Please wait</text>
			</text>
			<text color="%winre_text_dim%">
				<font resource="winre_body"/>
				<placement x="%center_x%" y="%winre_wait_sub_y%" placement="5"/>
				<text>Restarting into Download mode</text>
			</text>
			<action>
				<action function="reboot">download</action>
			</action>
			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="back"/>
				<action function="page">main</action>
			</action>
			<action>
				<touch key="power+voldown"/>
				<action function="screenshot"/>
			</action>
		</page>
	</pages>
</recovery>
